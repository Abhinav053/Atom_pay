# ===================================================
# AtomPay Microservices Ecosystem Environment Template
# ===================================================

APP_PORT=8080
PORT=3000

# Database & Cache Connections
DATABASE_URL=postgres://postgres:postgres@localhost:5432/atompay
MONGO_URL=mongodb://localhost:27017/atompay?replicaSet=rs0
REDIS_URL=redis://localhost:6379

# Security Secrets & Keys
JWT_SECRET=dev-secret-key-atompay
OTP_SECRET=dev-otp-secret-atompay
PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret
PAYMENT_WEBHOOK_URL=http://localhost:3000/api/webhooks/payment

# Internal Service Interconnect URLs (Local Development)
AUTH_SERVICE_URL=http://localhost:3001
WALLET_SERVICE_URL=http://localhost:3002
PAYMENT_SERVICE_URL=http://localhost:3003
REFUND_SERVICE_URL=http://localhost:3004
WEBHOOK_SERVICE_URL=http://localhost:3005
LEDGER_SERVICE_URL=http://localhost:3006
NOTIFICATION_SERVICE_URL=http://localhost:3007
AGENT_SERVICE_URL=http://localhost:8000

# Third-Party API Keys
BREVO_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
VERIFY_RESPONSES=true

# Gateway Controls
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000
MAINTENANCE_MODE=false
